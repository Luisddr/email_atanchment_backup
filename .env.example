GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

# Correo del empleador desde donde llegan los CFDIs de nómina (obligatorio)
PAYROLL_SENDER=nominas@tuempresa.com

# Drive: usa DRIVE_ROOT_FOLDER_ID si ya tienes una carpeta creada.
# Si no defines ID, el script usará DRIVE_ROOT_FOLDER_NAME y la creará si no existe.
DRIVE_ROOT_FOLDER_ID=
DRIVE_ROOT_FOLDER_NAME=1st_quarter_2026
DRIVE_PAYROLL_FOLDER_NAME=payroll
DRIVE_OTHERS_FOLDER_NAME=others
